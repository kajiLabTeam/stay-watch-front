{
  "name": "stay-watch-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -f .env.development -- vite",
    "build": "dotenvx run -f .env.development -- vite build",
    "start": "vite preview",
    "format": "oxfmt ./src",
    "format:check": "oxfmt --check ./src",
    "lint": "oxlint --fix ./src",
    "lint:check": "oxlint ./src",
    "typecheck": "tsc --noEmit",
    "deploy": "dotenvx run -f .env.prod -- vite build --mode prod && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/kosugi-maru": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@mantine/core": "^9.8.2",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "echarts": "^6.1.0",
    "firebase": "13.4.0",
    "jotai": "^3.0.2",
    "ofetch": "^1.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
